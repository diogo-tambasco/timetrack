# Timetrack — variáveis de ambiente (dev local / compose dev)
# Copie pra `.env` e preencha com valores reais. NUNCA commitar o .env.

# DSN do Postgres (obrigatória — o boot falha sem ela)
DATABASE_URL=postgres://timetrack:troque-me@localhost:5432/timetrack?sslmode=disable

# Endereço do listener HTTP (opcional, default :8080)
ADDR=:8080
