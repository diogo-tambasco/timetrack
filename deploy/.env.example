# Timetrack — env de PRODUÇÃO (copiar pra deploy/.env na VPS — gitignored).
# Só placeholders aqui. Valores reais: SECRETS.local.md / cofre do Diogo.

# Senha do Postgres do compose (usada também na DATABASE_URL)
POSTGRES_PASSWORD=troque-me

# DSN do app (host = nome do serviço no compose)
DATABASE_URL=postgres://timetrack:troque-me@timetrack-db:5432/timetrack?sslmode=disable

# Listener interno do app (o Caddy existente faz o TLS)
ADDR=:8080

# --- Fase 01: OAuth Google + sessão ---
# Credencial do Google Cloud Console (PENDENCIAS-DIOGO P-01; placeholders
# bastam pro build local — o login real exige a credencial verdadeira)
GOOGLE_CLIENT_ID=troque-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=troque-me
# prod: https://timmingtrack.life/auth/google/callback
OAUTH_REDIRECT_URL=https://timmingtrack.life/auth/google/callback
# 64 chars hex = 32 bytes (gerar: openssl rand -hex 32). Cifra AES-256-GCM
# dos tokens do Google em repouso. NUNCA commitar o valor real.
TT_TOKEN_KEY=troque-me-64-hex
# true em produção (cookies Secure atrás do Caddy/TLS)
COOKIE_SECURE=true
